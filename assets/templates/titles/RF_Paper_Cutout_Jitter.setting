				Jitter = Transform {
					CtrlWZoom = false,
					Inputs = {
						Input = Input {
							SourceOp = "Card",
							Source = "Output",
						},
						Angle = Input {
							Value = 0,
							Expression = "Jitter.Wobble * (((sin(floor(time / max(1, Jitter.Hold)) * 12.9898 + 3.3) * 43758.5453) % 1) - 0.5) * 2",
						},
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 + Jitter.Shake * (((sin(floor(time / max(1, Jitter.Hold)) * 12.9898 + 5.1) * 43758.5453) % 1) - 0.5), 0.5 + Jitter.Shake * (((sin(floor(time / max(1, Jitter.Hold)) * 12.9898 + 8.9) * 43758.5453) % 1) - 0.5))",
						},
						Size = Input {
							Value = 1,
							Expression = "iif(time < 2*Jitter.Hold, 0.4, iif(time < 4*Jitter.Hold, 1.15, 1))",
						},
						Hold = Input {
							Value = 3,
						},
						Wobble = Input {
							Value = 3,
						},
						Shake = Input {
							Value = 0.004,
						},
