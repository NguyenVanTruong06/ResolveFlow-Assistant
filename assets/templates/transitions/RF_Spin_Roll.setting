{
	Tools = ordered() {
		RF_Spin_Roll = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			CustomData = {
				Style = "Spin Roll 90/180",
				Kind = "Transition",
			},
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "ClipA",
					Source = "Input",
				},
				MainInput2 = InstanceInput {
					SourceOp = "ClipB",
					Source = "Input",
				},
				Degrees = InstanceInput {
					SourceOp = "ClipA",
					Source = "Degrees",
					Name = "Spin Degrees",
					Page = "Controls",
				},
				Zoom = InstanceInput {
					SourceOp = "ClipA",
					Source = "ZoomOut",
					Name = "Zoom Punch",
					Page = "Controls",
				},
				Shutter = InstanceInput {
					SourceOp = "Spin",
					Source = "ShutterAngle",
					Name = "Motion Blur Shutter",
					Page = "Controls",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Spin",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
			},
			Tools = ordered() {
				ClipA = PipeRouter {
					CtrlWZoom = false,
					Inputs = {
						Progress = Input {
							Value = 0,
							Expression = "(time - comp.RenderStart) / max(1, comp.RenderEnd - comp.RenderStart)",
						},
						Degrees = Input {
							Value = 180,
						},
						ZoomOut = Input {
							Value = 0.6,
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { 0, -66 },
					},
					UserControls = ordered() {
						Progress = {
							LINKS_Name = "Progress (auto)",
							ICS_ControlPage = "Controls",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
						},
						Degrees = {
							LINKS_Name = "Spin Degrees (90/180)",
							ICS_ControlPage = "Controls",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 180,
							INP_MinScale = 45,
							INP_MaxScale = 360,
						},
						ZoomOut = {
							LINKS_Name = "Zoom Punch",
							ICS_ControlPage = "Controls",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 2,
						},
					},
				},
				ClipB = PipeRouter {
					CtrlWZoom = false,
					Inputs = { },
					ViewInfo = OperatorInfo {
						Pos = { 0, 66 },
					},
				},
				Switch = Dissolve {
					CtrlWZoom = false,
					Inputs = {
						Background = Input {
							SourceOp = "ClipA",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "ClipB",
							Source = "Output",
						},
						Mix = Input {
							Value = 0,
							Expression = "iif(ClipA.Progress >= 0.5, 1, 0)",
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { 110, 0 },
					},
				},
				Spin = Transform {
					CtrlWZoom = false,
					Inputs = {
						Input = Input {
							SourceOp = "Switch",
							Source = "Output",
						},
						Angle = Input {
							Value = 0,
							Expression = "iif(ClipA.Progress < 0.5, ClipA.Degrees * (min(1, max(0, (ClipA.Progress * 2)))^3), -ClipA.Degrees * (1 - (1 - (1 - min(1, max(0, (ClipA.Progress * 2 - 1))))^3)))",
						},
						Size = Input {
							Value = 1,
							Expression = "1 + ClipA.ZoomOut * sin(pi * ClipA.Progress)",
						},
						Edges = Input {
							Value = 3,
						},
						MotionBlur = Input {
							Value = 1,
						},
						Quality = Input {
							Value = 10,
						},
						ShutterAngle = Input {
							Value = 360,
						},
						CenterBias = Input {
							Value = 0,
						},
						SampleSpread = Input {
							Value = 1,
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { 220, 0 },
					},
				},
			},
		},
	},
	ActiveTool = "RF_Spin_Roll",
}
