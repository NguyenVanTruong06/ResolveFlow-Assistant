-- RF_KineticTitle.setting  (Fusion Title macro - "Mode B": Text+ + Follower)
-- Cài: copy vào thư mục Templates/Edit/Titles của Resolve, khởi động lại Resolve.
--   macOS  : ~/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Templates/Edit/Titles/
--   Windows: %APPDATA%\Blackmagic Design\DaVinci Resolve\Support\Fusion\Templates\Edit\Titles\
-- Các control trong "Inputs" (InstanceInput) sẽ hiện trong Inspector của trang Edit
-- -> editor sửa text/font/màu mà không cần mở Fusion.
--
-- VERIFY: tên input của Follower (Delay, Order, Size, Red1...) có thể khác giữa các bản
-- Resolve. Cách chắc chắn nhất: dựng 1 Text+ + Follower trong Fusion, Ctrl+C node,
-- dán vào text editor -> lấy đúng ID rồi sửa file này.
{
	Tools = ordered() {
		RF_KineticTitle = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				-- ===== Nội dung (Python set qua API: tool.SetInput("Text", ...)) =====
				Text = InstanceInput { SourceOp = "Follower1", Source = "Text", Name = "Text", Default = "THÀNH CÔNG", },
				-- ===== Style =====
				Font = InstanceInput { SourceOp = "Template", Source = "Font", ControlGroup = 1, },
				Style = InstanceInput { SourceOp = "Template", Source = "Style", ControlGroup = 1, },
				Size = InstanceInput { SourceOp = "Template", Source = "Size", Default = 0.085, },
				Center = InstanceInput { SourceOp = "Template", Source = "Center", },
				Red1 = InstanceInput { SourceOp = "Template", Source = "Red1", Name = "Text Color", ControlGroup = 2, Default = 1, },
				Green1 = InstanceInput { SourceOp = "Template", Source = "Green1", ControlGroup = 2, Default = 1, },
				Blue1 = InstanceInput { SourceOp = "Template", Source = "Blue1", ControlGroup = 2, Default = 1, },
				-- ===== Timing (Python tính từ Whisper) =====
				Delay = InstanceInput { SourceOp = "Follower1", Source = "Delay", Name = "Frames / char", Default = 2, },
				Order = InstanceInput { SourceOp = "Follower1", Source = "Order", },
			},
			Outputs = {
				Output = InstanceOutput { SourceOp = "Template", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Template = TextPlus {
					Inputs = {
						GlobalOut = Input { Value = 119, },
						Width = Input { Value = 1080, },
						Height = Input { Value = 1920, },
						UseFrameFormatSettings = Input { Value = 1, },
						-- Text+ lấy chữ đã được Follower "chia" theo ký tự
						StyledText = Input { SourceOp = "Follower1", Source = "StyledText", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.085, },
						Center = Input { Value = { 0.5, 0.3 }, },
						Enabled2 = Input { Value = 1, },      -- outline (VERIFY element 2)
						Thickness2 = Input { Value = 0.08, },
						Red2 = Input { Value = 0, }, Green2 = Input { Value = 0, }, Blue2 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				-- Follower: mỗi ký tự chạy lại CÙNG một đường cong, lệch nhau "Delay" frame.
				Follower1 = StyledTextFollower {
					Inputs = {
						Text = Input { Value = "THÀNH CÔNG", },
						Delay = Input { Value = 2, },
						Order = Input { Value = 0, },   -- 0 = Left to right
						-- Đường cong scale pop/elastic cho TỪNG ký tự (spring tắt dần)
						Size = Input { SourceOp = "Follower1Size", Source = "Value", },
					},
				},
				Follower1Size = BezierSpline {
					SplineColor = { Red = 240, Green = 120, Blue = 30 },
					NameSet = true,
					KeyFrames = {
						[0] = { 0, RH = { 1.3, 0.6 }, },
						[4] = { 1.25, LH = { 2.7, 1.25 }, RH = { 5, 1.25 }, },
						[7] = { 0.92, LH = { 6, 0.92 }, RH = { 8, 0.92 }, },
						[10] = { 1.03, LH = { 9, 1.03 }, RH = { 11, 1.03 }, },
						[13] = { 1, LH = { 12, 1 }, },
					},
				},
			},
		},
	},
	ActiveTool = "RF_KineticTitle",
}
