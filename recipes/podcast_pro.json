{
  "id": "podcast_pro",
  "name": "Podcast Studio Chuẩn",
  "description": "Lọc sạch nói vấp, khử im lặng, phụ đề viền thanh lịch cho podcast dài",
  "workflow_mode": "podcast",
  "model_size": "small",
  "language": "Tiếng Việt",
  "ai_mode": "clean_talk",
  "remove_bad_takes": true,
  "enable_punch_in": true,
  "punch_in_scale": 1.15,
  "confidence_threshold": 0.7,
  "enable_reframe": false,
  "enable_broll": true,
  "enable_sfx": false,
  "enable_subtitles": true,
  "text_preset_id": "clean_outline",
  "split_mode": "characters",
  "split_limit": 42,
  "font_name": "Arial",
  "font_size": 48,
  "run_cut": true,
  "speed_up_silence": false,
  "silence_speed": 8.0,
  "silence_db": -35.0,
  "min_duration": 0.5,
  "enable_vlog_hook": false,
  "vlog_hook_duration": 2.0
}